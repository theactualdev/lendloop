# Both values are used as raw text (UTF-8 bytes) on both sides, never base64-decoded.
# Convex -> n8n webhook signing secret (HS256). Generate with: openssl rand -base64 32
LENDLOOP_TO_N8N_SECRET=
# n8n -> Convex HTTP route signing secret (HS256). Generate with: openssl rand -base64 32
N8N_TO_LENDLOOP_SECRET=
