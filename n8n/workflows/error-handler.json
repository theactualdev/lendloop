    "id": "llErrorHandler01",
    "name": "LendLoop · Error handler",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {},
        "id": "a1000000-0000-4000-8000-000000000001",
        "name": "Error Trigger",
        "type": "n8n-nodes-base.errorTrigger",
        "typeVersion": 1,
        "position": [
          0,
          0
        ]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "f1",
                "name": "workflow",
                "value": "={{ $json.workflow?.name ?? 'unknown workflow' }}",
                "type": "string"
              },
              {
                "id": "f2",
                "name": "executionId",
                "value": "={{ String($json.execution?.id ?? $execution.id) }}",
                "type": "string"
              },
              {
                "id": "f3",
                "name": "node",
                "value": "={{ $json.execution?.lastNodeExecuted ?? 'unknown node' }}",
                "type": "string"
              },
              {
                "id": "f4",
                "name": "message",
                "value": "={{ String($json.execution?.error?.message ?? 'unknown error').replace(/[A-Za-z0-9._%+'-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+/g, '[redacted]').slice(0, 500) }}",
                "type": "string"
              },
              {
                "id": "f5",
                "name": "url",
                "value": "={{ $json.execution?.url ?? '' }}",
                "type": "string"
              }
            ]
          },
          "options": {}
        },
        "id": "a1000000-0000-4000-8000-000000000002",
        "name": "Shape failure",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          220,
          0
        ]
      },
      {
        "parameters": {
          "operation": "sign",
          "useJson": true,
          "claimsJson": "={{ (() => { const iat = Math.floor(Date.now() / 1000); return JSON.stringify({ aud: \"lendloop-convex\", scope: \"failures:write\", iat, exp: iat + 300, jti: $execution.id + \"-\" + Date.now() + \"-\" + Math.random().toString(36).slice(2, 10), workflow: $json.workflow, executionId: $json.executionId, node: $json.node, message: $json.message }); })() }}",
          "options": {}
        },
        "id": "a1000000-0000-4000-8000-000000000003",
        "name": "Sign failure token",
        "type": "n8n-nodes-base.jwt",
        "typeVersion": 1,
        "position": [
          460,
          -120
        ],
        "credentials": {
          "jwtAuth": {
            "id": "n8nToLendloop01",
            "name": "n8n → LendLoop"
          }
        },
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/automation/failures",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ token: $json.token }) }}",
          "options": {}
        },
        "id": "a1000000-0000-4000-8000-000000000004",
        "name": "Report to Convex",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          700,
          -120
        ],
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 5000,
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "fromEmail": "lendloop@localhost",
          "toEmail": "={{ $env.ADMIN_ALERT_EMAIL }}",
          "subject": "=[LendLoop] Workflow failed: {{ $json.workflow }}",
          "emailFormat": "text",
          "text": "=Workflow: {{ $json.workflow }}\nExecution: {{ $json.executionId }}\nFailed node: {{ $json.node }}\nError: {{ $json.message }}\n{{ $json.url ? \"Execution URL: \" + $json.url : \"\" }}\n",
          "options": {
            "appendAttribution": false
          }
        },
        "id": "a1000000-0000-4000-8000-000000000005",
        "name": "Email admin",
        "type": "n8n-nodes-base.emailSend",
        "typeVersion": 2.1,
        "position": [
          460,
          -240
        ],
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 5000,
        "credentials": {
          "smtp": {
            "id": "mailpitSmtp00001",
            "name": "Mailpit"
          }
        },
        "onError": "continueRegularOutput"
      }
    ],
    "connections": {
      "Error Trigger": {
        "main": [
          [
            {
              "node": "Shape failure",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Shape failure": {
        "main": [
          [
            {
              "node": "Sign failure token",
              "type": "main",
              "index": 0
            },
            {
              "node": "Email admin",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Sign failure token": {
        "main": [
          [
            {
              "node": "Report to Convex",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
