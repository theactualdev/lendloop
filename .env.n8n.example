# n8n user folder (workflows, credentials DB); data lands in ./.n8n/.n8n (git-ignored)
N8N_USER_FOLDER=./.n8n
# Key encrypting n8n credentials; generate randomly, never change after first start:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
N8N_ENCRYPTION_KEY=
# Address that receives admin alert emails (Mailpit catches every address locally)
ADMIN_ALERT_EMAIL=admin@example.test
# Timezone for n8n schedules
GENERIC_TIMEZONE=UTC
# Convex HTTP-actions URL (local default http://127.0.0.1:3211)
LENDLOOP_CONVEX_SITE_URL=http://127.0.0.1:3211
# Public URL of the Next.js app (links in emails)
APP_URL=http://localhost:3000
# Allow workflows to read env vars (non-secret config only)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Prune old execution data (it holds recipient addresses)
EXECUTIONS_DATA_PRUNE=true
# Max age of kept executions in hours (7 days)
EXECUTIONS_DATA_MAX_AGE=168
