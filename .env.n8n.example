# n8n user folder (workflows, credentials DB)
N8N_USER_FOLDER=
# Key encrypting n8n credentials; generate randomly, never change after first start
N8N_ENCRYPTION_KEY=
# Address that receives admin alert emails
ADMIN_ALERT_EMAIL=
# Timezone for n8n schedules
GENERIC_TIMEZONE=
# Convex HTTP-actions URL (local default http://127.0.0.1:3211)
LENDLOOP_CONVEX_SITE_URL=
# Public URL of the Next.js app
APP_URL=
# Allow workflows to read env vars (non-secret config only)
N8N_BLOCK_ENV_ACCESS_IN_NODE=
# Prune old execution data
EXECUTIONS_DATA_PRUNE=
# Max age of kept executions in hours
EXECUTIONS_DATA_MAX_AGE=
