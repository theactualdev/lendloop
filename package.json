{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:all": "concurrently -n next,convex,n8n,mailpit -c blue,magenta,green,yellow \"next dev\" \"convex dev\" \"dotenv -e .env.n8n -- n8n start\" \".tools\\mailpit\\mailpit.exe --listen 127.0.0.1:8025 --smtp 127.0.0.1:1025\"",
    "n8n:export": "node scripts/n8n-export.mjs",
    "n8n:import": "dotenv -e .env.n8n -- n8n import:workflow --separate --input=n8n/workflows",
    "check:secrets": "node scripts/check-workflows.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "convex": "^1.49.0",
    "convex-helpers": "^0.1.134",
    "date-fns": "^4.4.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "convex-test": "^0.0.69",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
