# Clerk publishable key (Clerk dashboard > API keys); lives in .env.local
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional: next.config.ts already inlines this at build time, so Clerk usage telemetry is off
# without it (the browser side is telemetry={false} in app/layout.tsx).
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
# Clerk secret key (Clerk dashboard > API keys); lives in .env.local
CLERK_SECRET_KEY=
# Convex deployment name; written to .env.local by `npx convex dev`
CONVEX_DEPLOYMENT=
# Convex API URL (local default http://127.0.0.1:3210); written to .env.local by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=
# Convex HTTP-actions URL (local default http://127.0.0.1:3211); written to .env.local by `npx convex dev`
NEXT_PUBLIC_CONVEX_SITE_URL=
# Clerk issuer for Convex auth; set with `npx convex env set CLERK_JWT_ISSUER_DOMAIN <issuer>`
CLERK_JWT_ISSUER_DOMAIN=
# Hosted demo only (hosted-demo branch). These live in the Convex env, set with `npx convex env set`:
#   EMAIL_TRANSPORT   n8n (default when unset) or brevo
#   BREVO_API_KEY     Brevo API key (SMTP & API -> API keys), used when EMAIL_TRANSPORT=brevo
#   MAIL_FROM         sender address, verified in Brevo
#   MAIL_FROM_NAME    optional sender name, default LendLoop
#   APP_URL           the site URL, for links in the emails
#   ADMIN_ALERT_EMAIL optional, gets an alert when a day's reminders fail
